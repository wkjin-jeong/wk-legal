# ko-law-api 인증키(OC) 설정 파일 예시
# 사용법: cp .env.example .env && chmod 600 .env  (이후 아래 값을 채운다)
# OC는 국가법령정보 공동활용(open.law.go.kr)에서 발급받은 이메일 ID 형식 인증키.
#
# 형식: 'KEY=값' 또는 'export KEY="값"' — '#' 주석, 인라인 주석(' #' 이후 잘림) 허용.
# 이미 설정된 환경변수는 .env가 덮어쓰지 않는다(환경변수 우선 유지).
# 자동 탐색 경로(첫 발견 후 멈춤):
#   $LAW_API_DOTENV → ./.env → scripts/.env → <skill 폴더>/.env
#   → ~/.law_api.env → ~/.config/korean-law-api/.env

LAW_GO_KR_OC=
